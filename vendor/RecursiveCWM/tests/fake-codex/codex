#!/bin/bash
# A stand-in for the codex CLI used by tests/test_runner_offline.sh: no model, no network.
# It answers `codex --version`, and `codex exec … "<task>"` / `codex exec … resume <sid> "<msg>"` the way the runner
# expects (prints "session id: …" and "tokens used"), then plays a fixed recursion in the node's directory:
#   root ("scene"), first call:   asks for two children            (writes children.json)
#   root, resumed:                delivers part.json + final.png    (whole again)
#   any child, first call:        delivers part.json + final.png
# The node directory is found from the task text (__CHAIN__/fractal/__NODE__ are substituted into the instruction).
case "$1" in --version) echo "codex-cli 0.154.0"; exit 0 ;; esac
args=("$@"); ROOT="."; RESUME=""; TEXT=""
for ((i=0;i<${#args[@]};i++)); do
  case "${args[$i]}" in
    --cd) ROOT="${args[$((i+1))]}"; i=$((i+1)) ;;
    -c|--config|--sandbox) i=$((i+1)) ;;
    resume) RESUME="${args[$((i+1))]}"; TEXT="${args[$((i+2))]}"; break ;;
    exec|--skip-git-repo-check) ;;
    *) TEXT="${args[$i]}" ;;
  esac
done
SID="$(date +%s%N | sha256sum | cut -c1-8)-0000-4000-8000-000000000000"
echo "session id: $SID"
deliver() { # <node-dir> <name>
  cat > "$1/component.js" <<J
// fake program for $2
export function build(THREE) { const g = new THREE.Group(); g.name = "$2"; return g; }
J
  printf '{"module":"component.js","export":"build","children":%s}\n' "$3" > "$1/part.json"
  echo "# account for $2" > "$1/account.md"
  "$ROOT/.venv/bin/python" -c "from PIL import Image; Image.new('RGB',(400,300),(200,120,90)).save('$1/final.png')" 2>/dev/null || printf 'x' > "$1/final.png"
}
if [ -n "$RESUME" ]; then
  # find the node whose .sid matches
  ND=$(grep -rl --include=.sid "$RESUME" "$ROOT/runs" | head -1 | xargs dirname)
  deliver "$ND" "$(basename "$ND")" '["house-a","house-b"]'
else
  # task text carries the run dir and node id: "…/runs/<name>/fractal/<node>…"
  REL=$(echo "$TEXT" | grep -o 'runs/[^ /]*/fractal/[^ /"),.]*' | head -1)
  ND="$ROOT/$REL"; NODE=$(basename "$REL"); mkdir -p "$ND"
  if [ "$NODE" = scene ]; then
    for K in house-a house-b; do mkdir -p "$ND/../$K"; echo "brief for $K" > "$ND/../$K/brief.md"; cp "$ND/target.png" "$ND/../$K/target.png"; echo '{"x":0,"y":0,"w":1,"h":1}' > "$ND/../$K/view.json"; done
    echo '["house-a","house-b"]' > "$ND/children.json"
  else
    deliver "$ND" "$NODE" '[]'
  fi
fi
echo "tokens used"
echo "1,234"
